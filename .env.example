OPENAI_API_KEY=sk-your-key-here

# Local Qdrant (docker compose)
QDRANT_URL=http://localhost:6333

# Temporal (docker compose)
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=naive-rag-ingestion

# Collection and models
COLLECTION_NAME=rag_documents
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=4

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Upload limits
MAX_FILES_PER_UPLOAD=10
INDEX_BATCH_SIZE=100

# Ingestion mode: false = sync (Stage 4), true = Temporal worker required
USE_TEMPORAL_INGESTION=false

# Optional RAGAS (Stage 6)
ENABLE_RAGAS_EVALUATION=false
